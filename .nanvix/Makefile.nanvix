#
# Usage: make -f .nanvix/Makefile.nanvix PLATFORM=<platform> PROCESS_MODE=<mode> \
#    MEMORY_SIZE=<size> NANVIX_HOME=<home> NANVIX_TOOLCHAIN=<toolchain> [target]
#
# Targets:
#   all              Build liblxml_etree.a, liblxml_elementpath.a, and the functional test ELF, then stage via install
#   install          Stage built artifacts into LIB_OUT/TEST_OUT and Python sources into PYTHON_OUT
#   clean            Remove build artifacts

# ===========================================================================
# Global Variables
# ===========================================================================

# Some assumptions:
# 1. This makefile is expected to be invoked via z.py.
# 2. Build goals (all, install) require the Nanvix SDK at
#    $(NANVIX_TOOLCHAIN); other goals (test-*, clean) are pure host-side.
# 3. Build ALWAYS runs before test and release.
# 4. The buildroot (libxml2, libxslt, zlib, cpython headers) is laid down
#    by `./z setup` at .nanvix/buildroot/ — its path is fixed, not
#    overridable.

.DEFAULT_GOAL=all
EXE = .elf

SRC_DIR         := $(CURDIR)
STATICLIB_ETREE       := dist/obj/liblxml_etree.a
STATICLIB_ELEMENTPATH := dist/obj/liblxml_elementpath.a
TEST_SRC        := .nanvix/test/test_lxml.c
TEST_ELF        := test_lxml$(EXE)

_NANVIX_DOCKER_BUILD_GOALS := all install $(STATICLIB_ETREE) $(STATICLIB_ELEMENTPATH) $(TEST_ELF)
_NANVIX_GOALS := $(or $(MAKECMDGOALS),$(.DEFAULT_GOAL))

# Ensure required variables are defined.
_REQUIRED := PLATFORM \
    PROCESS_MODE \
    MEMORY_SIZE \
    NANVIX_HOME \
    NANVIX_TOOLCHAIN \
    NANVIX_ROOT \
    OUT_DIR \
    DIST_DIR \
    LIB_OUT \
    INCLUDE_OUT \
    TEST_OUT
ifneq ($(filter-out clean,$(_NANVIX_GOALS)),)
  $(foreach v,$(_REQUIRED),\
    $(if $($v),,$(error Required variable $v not set))\
  )
endif

SYSROOT_PATH   := $(abspath $(NANVIX_HOME))
BUILDROOT_PATH := $(abspath $(CURDIR)/.nanvix/buildroot)
NPROC := $(shell nproc 2>/dev/null || echo 4)

# Python source tree is staged alongside lib/include under the release dir
# so that `./z release` packages it via the inherited ZScript.release().
PYTHON_OUT := $(OUT_DIR)/release/python-packages

# ===========================================================================
# Build Mode Variables
# ===========================================================================

_BUILD := $(filter $(_NANVIX_DOCKER_BUILD_GOALS),$(_NANVIX_GOALS))
_NONBUILD := $(filter-out $(_NANVIX_DOCKER_BUILD_GOALS),$(_NANVIX_GOALS))
ifneq ($(_BUILD),)
  ifneq ($(_NONBUILD),)
    $(error Cannot mix build and non-build targets. Build targets: $(_NANVIX_DOCKER_BUILD_GOALS))
  endif

  ifeq ($(wildcard $(NANVIX_TOOLCHAIN)/nanvix-sdk.json),)
    $(error Nanvix SDK not found at $(NANVIX_TOOLCHAIN))
  endif
  ifeq ($(wildcard $(NANVIX_TOOLCHAIN)/bin/clang),)
    $(error Nanvix SDK Clang not found at $(NANVIX_TOOLCHAIN)/bin/clang)
  endif
endif

CC         := $(NANVIX_TOOLCHAIN)/bin/clang
AR         := $(NANVIX_TOOLCHAIN)/bin/llvm-ar
RANLIB     := $(NANVIX_TOOLCHAIN)/bin/llvm-ranlib
PKG_CONFIG ?= pkgconf
PKG_CONFIG_ENV := PKG_CONFIG_PATH=$(BUILDROOT_PATH)/lib/pkgconfig
XML_CFLAGS := $(shell $(PKG_CONFIG_ENV) $(PKG_CONFIG) --cflags libxslt 2>/dev/null)
XML_LIBS   := $(shell $(PKG_CONFIG_ENV) $(PKG_CONFIG) --static --libs libxslt 2>/dev/null)

TARGET_CFLAGS := -Os -fdata-sections -ffunction-sections
TARGET_CPPFLAGS := \
	-I$(SRC_DIR)/.nanvix/nanvix-port/cpython-headers \
	$(XML_CFLAGS) \
	-I$(SRC_DIR)/src \
	-I$(SRC_DIR)/src/lxml/includes

# ===========================================================================
# Build Targets
# ===========================================================================

all: check-deps $(STATICLIB_ETREE) $(STATICLIB_ELEMENTPATH) $(TEST_ELF) install

check-deps:
	@test -f $(BUILDROOT_PATH)/lib/libz.a
	@test -f $(BUILDROOT_PATH)/lib/libxml2.a
	@test -f $(BUILDROOT_PATH)/lib/libxslt.a
	@$(PKG_CONFIG_ENV) $(PKG_CONFIG) --exact-version=2.12.9 libxml-2.0
	@$(PKG_CONFIG_ENV) $(PKG_CONFIG) --exact-version=1.1.42 libxslt
	@test "$$(realpath "$$($(PKG_CONFIG_ENV) $(PKG_CONFIG) --variable=prefix libxml-2.0)")" = "$(BUILDROOT_PATH)"
	@test "$$(realpath "$$($(PKG_CONFIG_ENV) $(PKG_CONFIG) --variable=prefix libxslt)")" = "$(BUILDROOT_PATH)"

dist/obj/lxml_etree.o: $(SRC_DIR)/src/lxml/etree.c | check-deps
	@mkdir -p $(@D)
	$(CC) $(TARGET_CFLAGS) $(TARGET_CPPFLAGS) -c $< -o $@

dist/obj/lxml_elementpath.o: $(SRC_DIR)/src/lxml/_elementpath.c | check-deps
	@mkdir -p $(@D)
	$(CC) $(TARGET_CFLAGS) $(TARGET_CPPFLAGS) -c $< -o $@

$(STATICLIB_ETREE): dist/obj/lxml_etree.o
	$(AR) rcs $@ $<
	$(RANLIB) $@

$(STATICLIB_ELEMENTPATH): dist/obj/lxml_elementpath.o
	$(AR) rcs $@ $<
	$(RANLIB) $@

$(TEST_ELF): $(TEST_SRC) | check-deps
	@test -f $(STATICLIB_ETREE) || { echo "  FAIL: $(STATICLIB_ETREE) not found; run 'build' first"; exit 1; }
	@test -f $(STATICLIB_ELEMENTPATH) || { echo "  FAIL: $(STATICLIB_ELEMENTPATH) not found; run 'build' first"; exit 1; }
	$(CC) \
	  $(XML_CFLAGS) \
	  $(TEST_SRC) \
	  $(XML_LIBS) \
	  -Wl,-z,noexecstack \
	  -o $@

# ===========================================================================
# Install (stage artifacts into release/test output tree)
# ===========================================================================

install: $(STATICLIB_ETREE) $(STATICLIB_ELEMENTPATH) $(TEST_ELF)
	@mkdir -p $(LIB_OUT) $(TEST_OUT) \
	          $(PYTHON_OUT)/lxml/html \
	          $(PYTHON_OUT)/lxml/isoschematron \
	          $(PYTHON_OUT)/lxml/includes
	cp -f $(STATICLIB_ETREE)       $(LIB_OUT)/
	cp -f $(STATICLIB_ELEMENTPATH) $(LIB_OUT)/
	cp -f $(TEST_ELF)              $(TEST_OUT)/
	cp -f $(SRC_DIR)/src/lxml/*.py $(PYTHON_OUT)/lxml/
	-cp -f $(SRC_DIR)/src/lxml/html/*.py          $(PYTHON_OUT)/lxml/html/          2>/dev/null || true
	-cp -f $(SRC_DIR)/src/lxml/isoschematron/*.py $(PYTHON_OUT)/lxml/isoschematron/ 2>/dev/null || true
	-cp -rf $(SRC_DIR)/src/lxml/includes/*        $(PYTHON_OUT)/lxml/includes/      2>/dev/null || true

# ===========================================================================
# Clean
# ===========================================================================

clean:
	rm -rf $(OUT_DIR) dist/ $(TEST_ELF)

.PHONY: all check-deps install clean
